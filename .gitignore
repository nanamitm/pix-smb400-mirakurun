# ---- Secrets (NEVER commit) ----
# NOTE: gitignore treats '#' as a comment ONLY at line start — inline comments
# after a pattern become part of the pattern and silently break the ignore rule.
# Keep each secret pattern on its own line with the comment ABOVE it.
# RSA private key for USB Boot signing
boot/rsa_key.pem
# same key, copied by make_usb_boot.py
boot/usb_boot_files/rsa_key.pem
# ACAS master key (device-specific)
.acas_key

# ---- Build artifacts ----
# Binaries built by `make build-bins` (src/ -> bin/)
/bin/*
!/bin/.gitkeep
*.o

# Boot files generated by make_usb_boot.py / build_initramfs.sh
boot/bootargs.bin
boot/root_rsa_pub_crc.bin
boot/initramfs_patched.uimg
boot/usb_boot_files/bootargs.bin
boot/usb_boot_files/root_rsa_pub_crc.bin
boot/usb_boot_files/initramfs_patched.uimg

# ---- Pulled from device (proprietary Android system libraries) ----
/android-libs/

# ---- User-supplied firmware / kernel image & extraction output ----
kernel.img
_*.extracted/
firmware_extracted/
# kernel.img symlink + kernel.img.extracted/ (derived, ~12M)
extractions/

# ---- scan_bs_tsid.py の候補出力 (差分確認用、コミット不要) ----
config/bs_tsid.conf.scanned

# ---- Work dirs ----
# Mirakurun-BS4K clone built during `make deploy-mirakurun`
/tmp/
node_modules/

# ---- Python ----
__pycache__/
*.pyc

# ---- OS / editor junk ----
.DS_Store
*.swp
